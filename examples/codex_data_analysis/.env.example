# Ark (or any OpenAI-compatible chat) credentials.
MODEL_AGENT_API_KEY=your-ark-api-key
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# Model choice matters here — see "Known rough edges" in the README.
# Verified end to end; doubao-seed-1-6-250615 cannot complete a multi-round turn.
MODEL_AGENT_NAME=deepseek-v4-flash-260425

# Required: Ark rejects VeADK's default prompt caching alongside the
# `instructions` field Codex always sends.
MODEL_AGENT_CACHING=disabled
