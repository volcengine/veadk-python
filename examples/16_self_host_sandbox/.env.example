# Copy to .env; configure privately. Explicit process variables take precedence.
ANTHROPIC_BASE_URL=https://gateway.example.com
ANTHROPIC_ENVIRONMENT_KEY=replace-me
# Required for environment polling and for creating a new remote Session.
ANTHROPIC_ENVIRONMENT_ID=replace-me
SANDBOX_AGENT_ID=replace-me
# Set only if your gateway requires an account header.
# X_TOP_ACCOUNT_ID=replace-me

MANAGED_AGENT_WORK_SCOPE=account
MA_AGENT_LOOP_RUNTIME_TYPE=agentkit_runtime
MANAGED_AGENT_TOOL_EXECUTION=remote
MANAGED_AGENT_WORK_CONCURRENCY=500
MANAGED_AGENT_WORKDIR=/workspace
# Runtime Identity may replace the explicit environment key.
# AGENTKIT_RUNTIME_ID=replace-me
# VOLCENGINE_REGION=cn-beijing

# Session event history and Ark response IDs provide cross-worker recovery.
# Worker bookkeeping is local; legacy PostgreSQL environment variables are ignored.

# Diagnostics are disabled by default. Model/poll traces contain safe metadata.
# Full event tracing includes user/tool content; keep outputs private.
# MANAGED_AGENT_MODEL_TRACE=true
# MANAGED_AGENT_POLL_TRACE=true
# MA_DEBUG_EVENTS=1

# Long-running Feishu bot channel (install extensions extra).
# TOOL_FEISHU_CHANNEL_APP_ID=replace-me
# TOOL_FEISHU_CHANNEL_APP_SECRET=replace-me
# TOOL_FEISHU_CHANNEL_TRANSPORT=ws
# TOOL_FEISHU_CHANNEL_STREAMING=true
# TOOL_FEISHU_CHANNEL_SHOW_THINKING=true
# TOOL_FEISHU_CHANNEL_SHOW_TOOL_CALLS=true
# TOOL_FEISHU_CHANNEL_SHOW_TOOL_RESULTS=true
# TOOL_FEISHU_CHANNEL_SEPARATE_TOOL_CALL_CARDS=true
# TOOL_FEISHU_CHANNEL_SEPARATE_THINKING_CARD=true
# TOOL_FEISHU_CHANNEL_CREATE_TOPIC=true

# Optional external inspector adapter for cloud acceptance scripts.
# AGENTKIT_TOOL_DEPLOY_SCRIPT=/absolute/path/to/your/agentkit_tool_deploy.py
# AGENTKIT_TOOL_ID=replace-me
